namespace GlobalTheory.SqTop
theorem square_top_term_joined_estimates : Published.HoweDualityReal → FunPr.ThetaLocalInputs → Published.HeckeFunctionalEquationAbs → IndefiniteRowSideFullHecke.ClassZetaValuationBounds.ToricDenominator → IndefiniteRowSideFullHecke.LatticeNormTransport.Transport → IndefiniteRowSideFullHecke.ZetaValueIdeals.ZetaDenominators → Refl → IndefiniteRowSideFullHecke.WeilTensorModels.ThetaIntegralsAgree → IndefiniteRowSideFullHecke.WeilTensorModels.LocalMatching → SqTop.DenSum ∧ SqTop.ThbSt ∧ SqTop.OneSqSt ∧ SqTop.BotSmall ∧ SqTop.BotNe ∧ SqTop.FieldDat ∧ SqTop.TorEx ∧ SqTop.DenEx ∧ SqTop.BotEx ∧ SqTop.LNe ∧ SqTop.TriEx ∧ SqTop.Tower := by
  intro hHD hPr hFE hTD hTr hZD hRefl hTI hLM
  have hS := T.completedHeckeL_bounded_in_vertical_strips
  have hInp := T.cmThetaNormBoundHypotheses_satisfied
  have hF : FieldDat := fieldDat
  have hL : LNe := lNe_of_functionalEquation hFE hS hF
  have hLB : LBound := T.heckeLValue_upperBound_permutedWeights_of_FE hFE hS hF
  have hTor : TorEx := ToricExist.torEx hTr hF hL
  have hBA : BetaArch := T.betaConjugate_mean_logAbs_bound_of_transport hTr hF hLB hTor
  have hDE : DenEx := DenExist.denEx hZD hF
  have hDS : DenSum := DenSumPf.denSum hZD hF
  have hThb : ThbSt := T.toricValueHeightBound_of_denominatorsMeans hTD hF hTor hDE hDS hBA
  have hBS : BotSmall := BotSmallProof.botSmall_holds
  have hBC : BotConst := T.botConst_of_theta_matching hPr hTI hLM hInp hBS hL
  have hBE : BotEx := T.bottomPairs_exist_baseTuple hInp
  have hBET : BotExT := T.bottomPairsExistEveryTuple_of_cmThetaHypotheses hInp
  have hNB : NormBig := T.normBig_of_lNe hPr hInp hL
  have hRL : RhoLow := T.lValueRatio_lower_bound_gauge hTD hF hTor
  have hTri : TriEx := T.triEx_of_howe_duality_real hHD hPr hTI hLM hL
  have hBN : BotNe := T.bottomTheta_nonvanishing hPr hTI hLM hInp hL hBS hNB hTri
  have hTw : Tower := T.tower_of_theta_matching_lNe hPr hTI hLM hL
  have hOne : OneSqSt := T.square_ratio_valuation_without_norm_formula hInp hL hTor hBS hBET hNB hBN hTri hTw hBC hRefl hRL
  exact ⟨hDS, hThb, hOne, hBS, hBN, hF, hTor, hDE, hBE, hL, hTri, hTw⟩
end GlobalTheory.SqTop
end

