    i1, k1, fun φ hφ m hm => funext fun S => ?_, fun φ hφ m hm => funext fun S => ?_, fun φ hφ φ' hφ' c hc => ?_⟩
  · obtain ⟨Z, rfl⟩ := ΘA.surjective S
