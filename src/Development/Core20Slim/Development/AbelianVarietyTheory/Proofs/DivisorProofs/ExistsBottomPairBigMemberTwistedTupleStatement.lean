  first | exact @GlobalTheory.FunObj.StdDatum.exists_bottom_big_modT | exact GlobalTheory.FunObj.StdDatum.exists_bottom_big_modT | (intros; apply GlobalTheory.FunObj.StdDatum.exists_bottom_big_modT <;> assumption)
