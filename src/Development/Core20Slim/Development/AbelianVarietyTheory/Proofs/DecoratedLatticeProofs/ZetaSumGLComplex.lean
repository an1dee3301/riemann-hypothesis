  have hval : P X₀ = eulerFac (B.map (z * ·)) (GlobalTheory.LFun.npow w (-(s + 1 / 2))) *
      eulerFac (B.map fun β => (z * β)⁻¹) (GlobalTheory.LFun.npow w (-(s + 1 / 2))) *
      (∏ i ∈ Finset.range r, (1 - (qV E w : ℂ) ^ (-(2 * s + r - i)))) * ℓ x := by
    simp only [P]
    rw [hcX, hprod]
