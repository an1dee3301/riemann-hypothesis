  have hprod : ∏ i ∈ Finset.range r, (1 - (qV E w : ℂ) ^ i * X₀ ^ 2) =
      ∏ i ∈ Finset.range r, (1 - (qV E w : ℂ) ^ (-(2 * s + r - i))) := by
    refine Finset.prod_congr rfl fun i _ => ?_
