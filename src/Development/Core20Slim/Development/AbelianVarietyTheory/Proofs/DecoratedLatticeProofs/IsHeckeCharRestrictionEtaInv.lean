theorem isHeckeChar_resEta_inv : ∀ (D : D7) (χ : (AE D)ˣ →* Circle) (m : ℕ), IsHeckeChar D χ → ResEta D χ m → IsHeckeChar D χ⁻¹ ∧ ResEta D χ⁻¹ m := by
  intro D χ m h1 h2
  refine ⟨⟨h1.1.inv, fun x => ?_⟩, resEta_inv h2⟩
  rw [MonoidHom.inv_apply, h1.2, inv_one]

