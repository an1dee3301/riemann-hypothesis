  first | exact @GlobalTheory.BaseMoveAt.lat_moves_at_place | exact GlobalTheory.BaseMoveAt.lat_moves_at_place | (intros; apply GlobalTheory.BaseMoveAt.lat_moves_at_place <;> assumption)
