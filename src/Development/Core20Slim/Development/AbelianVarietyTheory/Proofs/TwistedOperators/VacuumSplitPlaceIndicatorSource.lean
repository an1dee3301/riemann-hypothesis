  rw [hβ, Circle.coe_one, one_mul] at hrule
  have hμ' := mul_right_cancel₀ hl (he.symm.trans hrule)
  rw [hμ', Complex.norm_real, Real.norm_of_nonneg (Real.rpow_nonneg (NNReal.coe_nonneg _) _)] at hn
  rw [hμ', hn, Complex.ofReal_one]

