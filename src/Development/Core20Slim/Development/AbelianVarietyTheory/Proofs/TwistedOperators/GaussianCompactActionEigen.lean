namespace GlobalTheory.FockVacStab

theorem mat_mul_mat_inv {F E : Type} [Field F] [NumberField F] [Field E] [NumberField E] [Algebra F E]
    {σ : E →ₐ[F] E} {n : ℕ} {X : Spc F E n} (k : UA σ X.J) : mat k * mat k⁻¹ = 1 ∧ mat k⁻¹ * mat k = 1 := by
  constructor
  · show (k * k⁻¹).1.1 = 1
    simp
  · show (k⁻¹ * k).1.1 = 1
    simp

