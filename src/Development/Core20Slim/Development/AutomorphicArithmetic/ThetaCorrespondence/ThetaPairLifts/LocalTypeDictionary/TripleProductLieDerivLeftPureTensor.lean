theorem exists_pure_tensor_lieDeriv_left_factor : Published.HoweDualityReal → FunPr.ThetaLocalInputs →
    ∀ (D : D7) (ψ : AddChar (AF D.host.F) ℂ) (θ : InfFam D), IsStdChar D ψ (-1) → IsInfFam θ →
    ∀ (W W₁ X : HSp D) (A : Fr W) (A₁ : Fr W₁) (B : Fr X) (α β : (AE D)ˣ →* Circle), IsTriple W W₁ X α β →
    ∀ (ωA : WRep W X) (ωB : WRep W₁ X), IsWeil ψ true W X β (β / α) ωA → IsWeil ψ false W₁ X α (α / β) ωB →
    ∀ (e : Fin (W.rank + W₁.rank) ≃ Fin X.rank) (Bs : IndefiniteRowSideFullHecke.WeilTensorModels.Base D.host.F D.host.E)
      (Γ : IndefiniteRowSideFullHecke.WeilTensorModels.Geo D.sp.cm.sig W.rank W₁.rank) (Xc : IndefiniteRowSideFullHecke.WeilTensorModels.Chars D.host.F D.host.E)
      (om : IndefiniteRowSideFullHecke.WeilTensorModels.Rep D.sp.cm.sig Γ.V Γ.W) (om' : IndefiniteRowSideFullHecke.WeilTensorModels.Rep D.sp.cm.sig Γ.V' Γ.W)
      (h : TripleRead.IsReading ψ A A₁ B α β e Bs Γ Xc),
      TripleRead.IsTransp ψ true Γ.M om ωA e (IndefiniteRowSideFullHecke.UnitaryConjugation.conjU W 1 h.JW) (TripleRead.toUX X e h.JX) →
      TripleRead.IsTransp ψ false Γ.M' om' ωB e (IndefiniteRowSideFullHecke.UnitaryConjugation.conjU W₁ (-1) h.JW₁) (TripleRead.toUX X e h.JX) →
      ∀ R Rf, IndefiniteRowSideFullHecke.WeilTensorModels.IsMatched Bs Γ Xc om om' R Rf →
      ∀ τ, ∀ Y ∈ lieAt X τ, ∀ γ ∈ IndefiniteRowSideFullHecke.WeilTensorModels.Lines D.sp.cm.sig Γ.W,
        (∀ t : ℝ, γ (Multiplicative.ofAdd t) = TripleRead.toUX X e h.JX (oneP θ X τ Y t)) →
        ∀ Φ ∈ algF ψ θ true A B, ∀ Φ' ∈ algF ψ θ true A B, IsDer θ X (fun g => ωA (1, g)) τ Y Φ Φ' →
        ∃ (m : ℕ) (f f₁ : Fin m → IndefiniteRowSideFullHecke.WeilTensorModels.SInf D.host.F (Fin W.rank × Fin (W.rank + W₁.rank)))
          (φ : Fin m → ∀ v : IndefiniteRowSideFullHecke.WeilTensorModels.Pl (F := D.host.F), (Fin W.rank × Fin (W.rank + W₁.rank) → Fv D.host.F v) → ℂ),
          (∀ i, f i ∈ Γ.M.Pol Bs.ψ Bs.emb ∧ (∀ v, φ i v ∈ WeilM.SB _) ∧ (∀ᶠ v in Filter.cofinite, φ i v = Γ.M.vac v) ∧
            IndefiniteRowSideFullHecke.WeilTensorModels.ActsD (IndefiniteRowSideFullHecke.WeilTensorModels.evI D.host.F) (fun t => om (1, γ (Multiplicative.ofAdd t))) (f i) (f₁ i)) ∧
          (∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (f₁ i) (φ i)) ∈ darbAlg Γ.M Bs.ψ Bs.emb ∧
          Φ = TripleRead.thO Γ.M ψ (sgn true W).gram e (∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (f i) (φ i)) ∧
          Φ' = TripleRead.thO Γ.M ψ (sgn true W).gram e (∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (f₁ i) (φ i)) := by
  intro hH hP D ψ θ hψ hθ W W₁ X A A₁ B α β hTr ωA ωB hA hB e Bs Γ Xc om om' h tA tB R Rf hm τ Y hY γ hγ hγt
    Φ hΦ Φ' hΦ' hD
  classical
  have hg := hm.triple.geo
  have hψ' : Bs.ψ = ψ := h.ψ
  have hstd : IndefiniteRowSideFullHecke.WeilTensorModels.IsStd ψ := hψ' ▸ hm.triple.base.std
  have hG : Γ.M.IsGood ψ := hψ' ▸ hg.hM
  obtain ⟨Ψ, hΨ, rfl⟩ := (T.triple_invariant_theta_surjective hH hP D ψ θ hψ hθ W W₁ X A A₁ B α β hTr ωA ωB hA hB e Bs Γ Xc om om' h tA tB
    R Rf hm).1 Φ hΦ
  obtain ⟨n, c, g, hsum⟩ := Submodule.mem_span_set'.1 hΨ
  choose f0 φ hf0 hφ hvac hpure using fun i => (g i).2
  let f : Fin n → IndefiniteRowSideFullHecke.WeilTensorModels.SInf D.host.F (Fin W.rank × Fin (W.rank + W₁.rank)) := fun i => c i • f0 i
  have hΨeq : Ψ = ∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (f i) (φ i) := by
    rw [← hsum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hpure i]
    funext x
    simp only [Pi.smul_apply, IndefiniteRowSideFullHecke.WeilTensorModels.pure, f, SchwartzMap.smul_apply, smul_eq_mul, mul_assoc]
  subst hΨeq
  have hfP : ∀ i, f i ∈ Γ.M.Pol Bs.ψ Bs.emb := fun i => Submodule.smul_mem _ _ (hf0 i)
  obtain ⟨δ, hδ⟩ := DerPol.polarization_pair_derivation hP Γ.M Bs.ψ Bs.emb Xc.β (Xc.β / Xc.α) om hm.triple.base.cm hm.triple.base.std
    hm.triple.weil γ hγ
  refine ⟨n, f, fun i => δ (f i), φ, fun i => ⟨hfP i, hφ i, hvac i, (hδ _ (hfP i)).2⟩,
    Submodule.sum_mem _ fun i _ => Submodule.subset_span ⟨δ (f i), φ i, (hδ _ (hfP i)).1, hφ i, hvac i, rfl⟩, rfl, ?_⟩
  have hstdi : ∀ i, ∀ᶠ v in Filter.cofinite,
      φ i v = Set.indicator {x | ∀ j, x j ∈ v.adicCompletionIntegers D.host.F} 1 := by
    intro i
    filter_upwards [hg.hM.std, hvac i] with v hv hv'
    rw [hv', hv]
  have hrest : ∀ i, IndefiniteRowSideFullHecke.WeilTensorModels.Rest (IndefiniteRowSideFullHecke.WeilTensorModels.evI D.host.F) (⇑(f i)) (EvZeroInf.finPart (φ i)) :=
    fun i => ⟨fun x z hz => EvZeroInf.finPart_add _ x z hz, by
      rw [← EvZeroInf.pure_eq_tens]; exact TensUniq.pure_mem_schA _ _ (hφ i) (hstdi i)⟩
  have hsum' : ∀ k : Fin n → IndefiniteRowSideFullHecke.WeilTensorModels.SInf D.host.F (Fin W.rank × Fin (W.rank + W₁.rank)),
      ∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (k i) (φ i) =
        ∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.tens (IndefiniteRowSideFullHecke.WeilTensorModels.evI D.host.F) (⇑(k i)) (EvZeroInf.finPart (φ i)) := fun k =>
    Finset.sum_congr rfl fun i _ => EvZeroInf.pure_eq_tens _ _
  have hmem : ∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (f i) (φ i) ∈ WeilM.schA D.host.F _ :=
    Submodule.sum_mem _ fun i _ => TensUniq.pure_mem_schA _ _ (hφ i) (hstdi i)
  have hone : IndefiniteRowSideFullHecke.UnitaryConjugation.conjU W 1 h.JW 1 = 1 := by
    apply Subtype.ext; simp [IndefiniteRowSideFullHecke.UnitaryConjugation.conjU]
  funext x
  have h1 : HasDerivAt (fun t : ℝ => WeilM.thetaSum D.host.F (Γ.M.co.rho ψ (TripleRead.ptO (sgn true W).gram e x)
      (om (1, γ (Multiplicative.ofAdd t)) (∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (f i) (φ i))))) (Φ' x) 0 := by
    refine (hD x).congr_of_eventuallyEq (Filter.Eventually.of_forall fun t => ?_)
    have h3 := tA _ hmem 1 (oneP θ X τ Y t)
    rw [hone, ← hγt t] at h3
    exact congrFun h3 x
  have h4 := T.twisted_theta_line_derivative hP Bs Γ Xc om om' hm.triple γ hγ n f (fun i => δ (f i)) (fun i => EvZeroInf.finPart (φ i))
    hrest (fun i => (hδ _ (hfP i)).2) (TripleRead.ptO (sgn true W).gram e x)
  rw [← hsum', ← hsum', hψ'] at h4
  exact (h4.unique h1).symm
end GlobalTheory.TripleAssembly
end
