theorem line_derivative_mem_fock_image : FunPr.ThetaLocalInputs →
  ∀ (D : D7) (ψ : AddChar (AF D.host.F) ℂ) (θ : InfFam D), IsStdChar D ψ (-1) → IsInfFam θ →
  ∀ (ε : Bool) (M X : HSp D) (A : Fr M) (B : Fr X) (χS χT : (AE D)ˣ →* Circle) (ω : WRep M X) (eS eT : D.what₂.Tau → ℚ),
  IsWeil ψ ε M X χS χT ω → (∀ τ, HasInfExp D χS τ (eS τ) ∧ HasInfExp D χT τ (eT τ)) →
  ∀ (Xs : IndefiniteRowSideFullHecke.WeilTensorModels.Spc D.host.F D.host.E M.rank) (Ws : IndefiniteRowSideFullHecke.WeilTensorModels.Spc D.host.F D.host.E X.rank)
    (Mo : IndefiniteRowSideFullHecke.WeilTensorModels.Model D.sp.cm.sig Xs Ws) (ψ' : AddChar (AF D.host.F) ℂ)
    (χX χW : IndefiniteRowSideFullHecke.WeilTensorModels.Chr D.host.F D.host.E) (om : IndefiniteRowSideFullHecke.WeilTensorModels.Rep D.sp.cm.sig Xs Ws)
    (τ : ∀ w : InfinitePlace D.host.F, AdelicU.EmbOver D.host.E w),
    PublishedHyps D Xs Ws Mo ψ' χX χW om τ → IsPairReading ψ ε A B ω Xs Ws Mo ψ' om τ →
    ∀ Φ : PolF D X.rank M.rank →ₗ[ℂ] IndefiniteRowSideFullHecke.WeilTensorModels.SInf D.host.F (Fin M.rank × Fin X.rank),
    Function.Injective Φ → LinearMap.range Φ = Mo.Pol ψ' τ → IsFockMap ψ θ ε A B Mo Φ →
      ∀ N : Submodule ℂ (PolF D X.rank M.rank),
        RealQuot.IsStab (fun i : RealQuot.LieIx X => RealQuot.actT ε A B eS i.1.1 i.1.2) N →
        ∀ γ ∈ IndefiniteRowSideFullHecke.WeilTensorModels.Lines D.sp.cm.sig Ws, ∀ f ∈ N.map Φ, ∀ f₁ : IndefiniteRowSideFullHecke.WeilTensorModels.SInf D.host.F (Fin M.rank × Fin X.rank),
          IndefiniteRowSideFullHecke.WeilTensorModels.ActsD (IndefiniteRowSideFullHecke.WeilTensorModels.evI D.host.F) (fun t => om (1, γ (Multiplicative.ofAdd t))) f f₁ →
          f₁ ∈ N.map Φ := by
  intro hPr D ψ θ hstd hθ ε M X A B χS χT ω eS eT hW hExp Xs Ws Mo ψ' χX χW om τ hPH hPR Φ hinj hrange hFock N hN γ hγ f hf f₁ hD
  have hψ := hPR.psi.symm
  subst hψ
  obtain ⟨P, hPN, rfl⟩ := Submodule.mem_map.1 hf
  obtain ⟨f₀, r, hvac, hf0, hΦ⟩ := hFock
  obtain ⟨h, Y, hY, hγh, hder⟩ := T.skewSpaceLine_oneParam_fockDerivative D ψ θ ε M X A B χS χT ω eS eT hθ hW hExp Ws hPR.JW γ hγ
  set Q := ∑ t, RealQuot.actT ε A B eS t (Y t) P with hQ
  have hQN : Q ∈ N := Submodule.sum_mem _ fun t _ => hN ⟨(t, Y t), hY t⟩ P hPN
  have hne : ∃ x, IndefiniteRowSideFullHecke.WeilTensorModels.tens (IndefiniteRowSideFullHecke.WeilTensorModels.evI D.host.F) (Φ 1) r x ≠ 0 := by
    by_contra hc
    push_neg at hc
    have h0 : IndefiniteRowSideFullHecke.WeilTensorModels.tens (IndefiniteRowSideFullHecke.WeilTensorModels.evI D.host.F) (Φ 1) r = 0 := funext hc
    have h1 := (hΦ 1).2
    rw [h0, thO_zero', ptF_one'] at h1
    exact hf0 h1.symm
  have hr : ∃ x, r x ≠ 0 := by
    obtain ⟨x, hx⟩ := hne
    exact ⟨x, fun h0 => hx (by simp [IndefiniteRowSideFullHecke.WeilTensorModels.tens, h0])⟩
  have hR1 : IndefiniteRowSideFullHecke.WeilTensorModels.Rest (IndefiniteRowSideFullHecke.WeilTensorModels.evI D.host.F) f₁ r := Twist.RestrictionTransfer.rest_transfer _ (Φ 1) r (hΦ 1).1 hne f₁
  have hT : ∀ t : ℝ, TripleRead.thO Mo ψ (sgn ε M).gram (Equiv.refl (Fin X.rank))
      (om (1, γ (Multiplicative.ofAdd t)) (IndefiniteRowSideFullHecke.WeilTensorModels.tens (IndefiniteRowSideFullHecke.WeilTensorModels.evI D.host.F) (Φ P) r)) =
      ω (1, h t) (ptF (V := sgn ε M) ψ θ (frSgn ε A) B f₀ P) := by
    intro t
    have e1 := hPR.transp (IndefiniteRowSideFullHecke.WeilTensorModels.tens (IndefiniteRowSideFullHecke.WeilTensorModels.evI D.host.F) (Φ P) r) (hΦ P).1.2 1 (h t)
    rw [conjU_one', ← hγh t] at e1
    rw [e1, (hΦ P).2]
  have key : TripleRead.thO Mo ψ (sgn ε M).gram (Equiv.refl (Fin X.rank))
      (IndefiniteRowSideFullHecke.WeilTensorModels.tens (IndefiniteRowSideFullHecke.WeilTensorModels.evI D.host.F) f₁ r) =
      TripleRead.thO Mo ψ (sgn ε M).gram (Equiv.refl (Fin X.rank))
      (IndefiniteRowSideFullHecke.WeilTensorModels.tens (IndefiniteRowSideFullHecke.WeilTensorModels.evI D.host.F) (Φ Q) r) := by
    funext x
    have a := T.theta_interchange_derivative_pure hPr D Xs Ws Mo ψ χX χW om τ hPH hPR.good γ hγ (Φ P) f₁ r (hΦ P).1 hR1 hD (sgn ε M).gram
      (Equiv.refl (Fin X.rank)) x
    have e2 : (fun t : ℝ => TripleRead.thO Mo ψ (sgn ε M).gram (Equiv.refl (Fin X.rank))
        (om (1, γ (Multiplicative.ofAdd t)) (IndefiniteRowSideFullHecke.WeilTensorModels.tens (IndefiniteRowSideFullHecke.WeilTensorModels.evI D.host.F) (Φ P) r)) x) =
        fun t : ℝ => ω (1, h t) (ptF (V := sgn ε M) ψ θ (frSgn ε A) B f₀ P) x := funext fun t => by rw [hT t]
    rw [e2] at a
    rw [a.unique (hder f₀ hvac P x), (hΦ Q).2]
  have hdet : ((sgn ε M).gram).det ≠ 0 := det_sgn_gram ε M (hPR.JX ▸ hPH.2.2.2.1)
  have heq := ThetaTransformInj.thO_injective D Xs Ws Mo ψ χX χW om τ hPH hPR.good (sgn ε M).gram (Equiv.refl (Fin X.rank)) hdet
    _ hR1.2 _ (hΦ Q).1.2 key
  exact ⟨Q, hQN, (ArchCancel.eq_of_tens_eq _ r (hΦ P).1.1 hr f₁ (Φ Q) heq).symm⟩
end GlobalTheory.RealDict.LineStab
