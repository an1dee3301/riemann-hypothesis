      refine (Size.growthSize_add_le).trans ?_
      have a1 : Size.growthSize (G.P i).V N (L - M) ≤ ε :=
        ((Size.growthSize_anti (le_max_right N₁ N₂)).trans hK.le)
      have a2 : Size.growthSize (G.P i).V N (M - Ψ) ≤ ε :=
        ((Size.growthSize_anti (le_max_left N₁ N₂)).trans hJ.le)
      refine (add_le_add a1 a2).trans (le_of_eq ?_)
      rw [hε, ENNReal.add_halves]
  choose ψ hψ hψb using key
  have ht : Filter.Tendsto (fun n => Size.growthSize (G.P i).V N (ψ n - L)) Filter.atTop (nhds 0) := by
    have h0 : Filter.Tendsto (fun n : ℕ => ((n : ENNReal) + 1)⁻¹) Filter.atTop (nhds 0) := by
