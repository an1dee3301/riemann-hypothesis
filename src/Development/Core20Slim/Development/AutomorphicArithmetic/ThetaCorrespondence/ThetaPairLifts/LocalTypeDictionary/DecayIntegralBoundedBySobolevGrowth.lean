theorem decayIntegral_le_sobolevGrowth : FunPr.ThetaLocalInputs → ∀ (D : D7), IndefiniteRowSideFullHecke.CuspAlongSmoothLifts.Sizes D → ∀ (G₀ : Type) [Group G₀] [Fintype G₀] (Pl0 T : Type) (A : FamIn D.what₂.LL G₀ Pl0 T D.R.m) (Ks : Type) [Field Ks] [NumberField Ks] [Algebra Ks D.what₂.LL] (R : RealDat D A Ks) (G : Grid.GridPre R), IndefiniteRowSideFullHecke.CuspAlongSmoothLifts.RowBase R → G.Is → ∀ i, i < D.R.m → ∀ U : Subgroup (GA D (G.P (i + 1)).V), IsOpen (U : Set (GA D (G.P (i + 1)).V)) → ∀ M : ℕ, ∃ (d : ℕ) (C : NNReal), ∀ ψ : GA D (G.P (i + 1)).V → ℂ, IsAutFun (G.P (i + 1)).V ψ → (∀ k ∈ U, k ∈ GfC (G.P (i + 1)).V → ∀ g, ψ (g * k) = ψ g) → ψ ∈ Mem.AutSpace.SmFun R.θ (G.P (i + 1)).V → (∀ k, Size.growthSob R.θ (G.P (i + 1)).V k 0 ψ ≠ ⊤) → IsCuspFun (G.P (i + 1)).V ψ → IndefiniteRowSideFullHecke.RapidDecayLift.decayInt (G.mP (i + 1)).ν (G.mP (i + 1)).fd M ψ ≤ (C : ENNReal) * Size.growthSob R.θ (G.P (i + 1)).V d 0 ψ := by
  intro hP D _ G₀ _ _ Pl0 T A Ks _ _ _ R G hB hG i hi U hU M
  obtain ⟨hν, h𝓕⟩ := MeasDat.haar_fd (hG.meas.P (i + 1) hi)
  obtain ⟨d, C₀, hC⟩ := hP.cuspDecaySobolev D R.θ hB.inf (G.P (i + 1)).V U hU 0 M
  have hfin : (G.mP (i + 1)).ν (G.mP (i + 1)).fd < ⊤ :=
    CuspDecay.measure_lt_top Mem.VolFin.finVol _ _ _ hν h𝓕
  refine ⟨d, C₀ * ((G.mP (i + 1)).ν (G.mP (i + 1)).fd).toNNReal, fun ψ ha hk hs hg hc => ?_⟩
  refine (IndefiniteRowSideFullHecke.RapidDecayLift.decayInt_le _ _ M ψ).trans ?_
  rw [ENNReal.coe_mul, ENNReal.coe_toNNReal hfin.ne, mul_right_comm]
  exact mul_le_mul' (hC ψ ha hk hs hg hc) le_rfl
end GlobalTheory.DownConv
