namespace GlobalTheory.MovedKappaDec
theorem exists_movedKappa_decomposition : FunPr.ThetaLocalInputs → (∀ D, NormSum.Inp D) → ∀ {D : D7} {Γ : Type} [Group Γ] [Fintype Γ] {Pl0 T : Type}
    {A : FamIn D.what₂.LL Γ Pl0 T D.R.m} {Ks : Type} [Field Ks] [NumberField Ks] [Algebra Ks D.what₂.LL] {R : RealDat D A Ks}
    (ch : Choice R), ch.Is → ∀ (X : Node), DefNode D.R.m X → ∀ (Q : Finset ℕ), (∀ q ∈ Q, q.Prime) → ∀ x : FinPt ch.G X,
    ∃ r s x₀ : FinPt ch.G X, MovedKappaEx.RatFin _ r ∧ s ∈ MovedKappaEx.splitOff _ Q ∧
      SumSize.latAt ch.S.toGridChoice X x₀ = stdL D _ ∧ (∀ q ∈ Q, EqAt D q (SumSize.latAt ch.S.toGridChoice X (s * x₀)) (stdL D _)) ∧ x = r * s * x₀ := by
  intro _ _ D Γ _ _ Pl0 T A Ks _ _ _ R ch _ X hX Q hQ x
  obtain ⟨r, s, k, hr, hs, hk, e⟩ := RatSplitLat.exists_rat_split_lat (ch.G.V X) (ch.S.N.fr X) (∏ q ∈ Q, q)
    (Finset.prod_pos fun q hq => (hQ q hq).pos) (x * ch.S.N.u X)
  have hs' := MovedKappaEx.mem_splitOff_of_suppSplit _ Q s hs
  have hB := LatStdStab.latAt_mul_inv_eq_stdL ch.S.toGridChoice X hX k hk
  refine ⟨r, s, k * (ch.S.N.u X)⁻¹, hr, hs', hB, fun q hq => ?_, ?_⟩
  · have key : ∀ s' ∈ MovedKappaEx.splitOff (ch.G.V X) Q, ∀ y : FinPt ch.G X,
        EqAt D q (SumSize.latAt ch.S.toGridChoice X (s' * y)) (SumSize.latAt ch.S.toGridChoice X y) := by
      intro s' hs'
      induction hs' using Subgroup.closure_induction with
      | mem g hg =>
        obtain ⟨e, he, hoff, hsupp⟩ := hg
        exact fun y => MovedSplitEq.eqAt_latAt_mul ch.S.toGridChoice X hX q (hQ q hq) e he (hoff q hq) g y hsupp
      | one => exact fun y => by rw [one_mul]; exact eqAt_refl q _
      | mul a b _ _ ha hb => exact fun y => by rw [mul_assoc]; exact eqAt_trans (ha (b * y)) (hb y)
      | inv a _ ha =>
        intro y
        have := ha (a⁻¹ * y)
        rw [mul_inv_cancel_left] at this
        exact eqAt_symm this
    have := key s hs' (k * (ch.S.N.u X)⁻¹)
    rw [hB] at this
    exact this
  · rw [← mul_assoc, ← e, mul_inv_cancel_right]
end GlobalTheory.MovedKappaDec
end
