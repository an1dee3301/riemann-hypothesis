namespace GlobalTheory.AvgCuspType
theorem cusp_average_isCuspOfType : ∀ (D : D7) (θ : InfFam D), IsInfFam θ → FunPr.ThetaLocalInputs → ∀ (N : Grid.Node D) (ψ : GA D N.V → ℂ), IndefiniteRowSideFullHecke.CuspAlongSmoothLifts.IsCuspOfType θ N ψ → ∀ (τ : D.what₂.Tau) (e : Formalism.REAL.KG (N.M.ε τ) → ℂ), TypeSum.KFinFun (N.M.ε τ) e → IndefiniteRowSideFullHecke.CuspAlongSmoothLifts.IsCuspOfType θ N (SeriesToClosure.avg θ N.V τ (N.M.ε τ) (N.M.fr τ) e ψ) := by
  intro D θ hθ hp N ψ hψ τ e he
  have hc : Continuous e := by obtain ⟨F, -, h1, h2, -⟩ := he; exact h2 _ h1
  refine ⟨?_, KFinCuspApprox.isCuspForm_kFinite_average θ hθ hp N τ e hc ψ hψ.1 hψ.2.1, fun τ' => ?_⟩
  · exact RealAverage.isAutFunSm_average D θ hθ N.V τ (Formalism.REAL.KG (N.M.ε τ)) (Formalism.REAL.muK (N.M.ε τ)) _
      SeriesToClosure.continuous_conjK
      (fun k => Published.AutFin.conj_mem_UH (N.M.fr_unit τ) (N.M.fr_gram τ) k) e hc ψ hψ.1
  · by_cases h : τ' = τ
    · subst h
      exact T.average_isTypeAt_same_place_twist D θ hθ hp N τ' ψ hψ.1 (hψ.2.2 τ') e he
    · exact T.average_isTypeAt_other_place_twist D θ hθ hp N τ τ' h ψ hψ.1 (hψ.2.2 τ') e he
end GlobalTheory.AvgCuspType
end

