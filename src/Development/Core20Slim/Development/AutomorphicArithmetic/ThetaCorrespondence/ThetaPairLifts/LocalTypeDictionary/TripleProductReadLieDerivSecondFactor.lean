theorem tripleProduct_read_lieDeriv_second_factor : Published.HoweDualityReal → FunPr.ThetaLocalInputs →
    ∀ (D : D7) (ψ : AddChar (AF D.host.F) ℂ) (θ : InfFam D), IsStdChar D ψ (-1) → IsInfFam θ →
    ∀ (W W₁ X : HSp D) (A : Fr W) (A₁ : Fr W₁) (B : Fr X) (α β : (AE D)ˣ →* Circle), IsTriple W W₁ X α β →
    ∀ (ωA : WRep W X) (ωB : WRep W₁ X), IsWeil ψ true W X β (β / α) ωA → IsWeil ψ false W₁ X α (α / β) ωB →
    ∀ (e : Fin (W.rank + W₁.rank) ≃ Fin X.rank) (Bs : IndefiniteRowSideFullHecke.WeilTensorModels.Base D.host.F D.host.E)
      (Γ : IndefiniteRowSideFullHecke.WeilTensorModels.Geo D.sp.cm.sig W.rank W₁.rank) (Xc : IndefiniteRowSideFullHecke.WeilTensorModels.Chars D.host.F D.host.E)
      (om : IndefiniteRowSideFullHecke.WeilTensorModels.Rep D.sp.cm.sig Γ.V Γ.W) (om' : IndefiniteRowSideFullHecke.WeilTensorModels.Rep D.sp.cm.sig Γ.V' Γ.W)
      (h : TripleRead.IsReading ψ A A₁ B α β e Bs Γ Xc),
      TripleRead.IsTransp ψ true Γ.M om ωA e (IndefiniteRowSideFullHecke.UnitaryConjugation.conjU W 1 h.JW) (TripleRead.toUX X e h.JX) →
      TripleRead.IsTransp ψ false Γ.M' om' ωB e (IndefiniteRowSideFullHecke.UnitaryConjugation.conjU W₁ (-1) h.JW₁) (TripleRead.toUX X e h.JX) →
      ∀ R Rf, IndefiniteRowSideFullHecke.WeilTensorModels.IsMatched Bs Γ Xc om om' R Rf →
      ∀ τ, ∀ Y ∈ lieAt X τ, ∀ γ ∈ IndefiniteRowSideFullHecke.WeilTensorModels.Lines D.sp.cm.sig Γ.W,
        (∀ t : ℝ, γ (Multiplicative.ofAdd t) = TripleRead.toUX X e h.JX (oneP θ X τ Y t)) →
        ∀ Φ ∈ algF ψ θ false A₁ B, ∀ Φ' ∈ algF ψ θ false A₁ B, IsDer θ X (fun g => ωB (1, g)) τ Y Φ Φ' →
        ∃ (m : ℕ) (f f₁ : Fin m → IndefiniteRowSideFullHecke.WeilTensorModels.SInf D.host.F (Fin W₁.rank × Fin (W.rank + W₁.rank)))
          (φ : Fin m → ∀ v : IndefiniteRowSideFullHecke.WeilTensorModels.Pl (F := D.host.F), (Fin W₁.rank × Fin (W.rank + W₁.rank) → Fv D.host.F v) → ℂ),
          (∀ i, f i ∈ Γ.M'.Pol Bs.ψ Bs.emb ∧ (∀ v, φ i v ∈ WeilM.SB _) ∧ (∀ᶠ v in Filter.cofinite, φ i v = Γ.M'.vac v) ∧
            IndefiniteRowSideFullHecke.WeilTensorModels.ActsD (IndefiniteRowSideFullHecke.WeilTensorModels.evI D.host.F) (fun t => om' (1, γ (Multiplicative.ofAdd t))) (f i) (f₁ i)) ∧
          (∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (f₁ i) (φ i)) ∈ darbAlg Γ.M' Bs.ψ Bs.emb ∧
          Φ = TripleRead.thO Γ.M' ψ (sgn false W₁).gram e (∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (f i) (φ i)) ∧
          Φ' = TripleRead.thO Γ.M' ψ (sgn false W₁).gram e (∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (f₁ i) (φ i)) := by
  intro hHowe hPr D ψ θ hψ hθ W W₁ X A A₁ B α β hT ωA ωB hA hB e Bs Γ Xc om om' h hTr hTr' R Rf hM τ Y hY γ hγ hγt Φ hΦ Φ' _ hDer
  have hstd : IndefiniteRowSideFullHecke.WeilTensorModels.IsStd ψ := h.ψ ▸ hM.triple.base.std
  have hG' : Γ.M'.IsGood ψ := h.ψ ▸ hM.triple.geo.hM'
  have hW : Γ.M'.IsWeil ψ Xc.α (Xc.α / Xc.β) om' := h.ψ ▸ hM.triple.weil'
  obtain ⟨Ψ, hΨ, rfl⟩ :=
    (T.triple_invariant_theta_surjective hHowe hPr D ψ θ hψ hθ W W₁ X A A₁ B α β hT ωA ωB hA hB e Bs Γ Xc om om' h hTr hTr' R Rf hM).2 Φ hΦ
  have hS := darbAlg_le_schA D.sp.cm.sig Γ.V' Γ.W Γ.M' Bs.ψ Bs.emb hM.triple.geo.hM' hΨ
  obtain ⟨m, f, φ, hf, rfl⟩ := exists_sum_pure Γ.M' Bs.ψ Bs.emb hΨ
  obtain ⟨δ, hδ⟩ := T.twist_lie_derivative_model hPr Bs Γ Xc om om' hM.triple γ hγ
  refine ⟨m, f, fun i => δ (f i), φ, fun i => ⟨(hf i).1, (hf i).2.1, (hf i).2.2, (hδ _ (hf i).1).2⟩, ?_, rfl, ?_⟩
  · exact Submodule.sum_mem _ fun i _ =>
      Submodule.subset_span ⟨δ (f i), φ i, (hδ _ (hf i).1).1, (hf i).2.1, (hf i).2.2, rfl⟩
  · funext x
    have h1 := T.theta_sum_differentiable_along_line hPr Γ.M' ψ Xc.α (Xc.α / Xc.β) om' hM.triple.base.cm hstd hG' hW γ hγ m f (fun i => δ (f i)) φ (fun i => (hf i).2)
      (fun i => (hδ _ (hf i).1).2) (TripleRead.ptO (sgn false W₁).gram e x)
    have hval : ∀ t : ℝ, WeilM.thetaSum D.host.F (Γ.M'.co.rho ψ (TripleRead.ptO (sgn false W₁).gram e x)
        (om' (1, γ (Multiplicative.ofAdd t)) (∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (f i) (φ i)))) =
        ωB (1, oneP θ X τ Y t) (TripleRead.thO Γ.M' ψ (sgn false W₁).gram e (∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (f i) (φ i))) x := by
      intro t
      have h2 := congrFun (hTr' _ hS 1 (oneP θ X τ Y t)) x
      rw [LocWeilAct.conjU_one', ← hγt t] at h2
      exact h2
    simp only [hval] at h1
    exact (hDer x).unique h1
end GlobalTheory.TripleAssembly.ReadDerB
end
