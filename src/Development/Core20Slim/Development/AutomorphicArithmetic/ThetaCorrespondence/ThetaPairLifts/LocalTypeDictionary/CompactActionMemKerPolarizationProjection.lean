    (cB : Matrix (Fin W₁.rank) (Fin (W.rank + W₁.rank)) (AE D) ≃+ WO W₁ X),
    IsInfFam θ → IsTriple W W₁ X α β → IsOver ψ θ A A₁ B α β ν 𝓕 ν₁ 𝓕₁ ωA ωB e Bs Γ Xc om om' cA cB →
    IndefiniteRowSideFullHecke.WeilTensorModels.IsTriple Bs Γ Xc om om' →
    ∀ Pi rf rl p p', IsMatch ψ θ A A₁ B α β ωA ωB Pi rf rl p p' →
    ∀ k ∈ IndefiniteRowSideFullHecke.WeilTensorModels.KInf D.sp.cm.sig Γ.V' Bs.emb, ∀ f ∈ Γ.M'.Pol Bs.ψ Bs.emb, ∀ f₁ ∈ Γ.M'.Pol Bs.ψ Bs.emb, IndefiniteRowSideFullHecke.WeilTensorModels.Acts (IndefiniteRowSideFullHecke.WeilTensorModels.evI D.host.F) (om' (k, 1)) f f₁ → ∀ φ : ∀ w : IndefiniteRowSideFullHecke.WeilTensorModels.Pl (F := D.host.F), ((Fin W₁.rank × Fin (W.rank + W₁.rank)) → Fv D.host.F w) → ℂ, (∀ w, φ w ∈ WeilM.SB _) → (∀ᶠ w in Filter.cofinite, φ w = Γ.M'.vac w) → IndefiniteRowSideFullHecke.WeilTensorModels.pure f₁ φ - IndefiniteRowSideFullHecke.WeilTensorModels.pure f φ ∈ kerPD ψ θ A₁ B Bs Γ cB p' := by
  intro hPr D ψ θ W W₁ X A A₁ B α β ν 𝓕 ν₁ 𝓕₁ ωA ωB e Bs Γ Xc om om' cA cB hθ hTr hO hT Pi rf rl p p' hM k hk f hf f₁ hf₁
    hAct φ hφ hv
  have hS := T.kInfty_exponential_line_in_derivative_span hPr D.host.F D.host.E D.sp.cm.sig Bs W₁.rank (W.rank + W₁.rank) Γ.V' Γ.W Γ.M' Xc.α (Xc.α / Xc.β) om' _ _ _ _
    (isPair_small hT) k hk f hf f₁ hAct
  have key : ∀ g ∈ Submodule.span ℂ {g₁ | g₁ ∈ Γ.M'.Pol Bs.ψ Bs.emb ∧ ∃ γ ∈ IndefiniteRowSideFullHecke.WeilTensorModels.Lines D.sp.cm.sig Γ.V',
      ∃ g ∈ Γ.M'.Pol Bs.ψ Bs.emb, IndefiniteRowSideFullHecke.WeilTensorModels.ActsD (IndefiniteRowSideFullHecke.WeilTensorModels.evI D.host.F)
        (fun t => om' (γ (Multiplicative.ofAdd t), 1)) g g₁},
      IndefiniteRowSideFullHecke.WeilTensorModels.pure g φ ∈ kerPD ψ θ A₁ B Bs Γ cB p' := by
    intro g hg
    induction hg using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨hx1, γ, hγ, g₀, hg₀, hD⟩ := hx
      exact T.ker_polarizationProjection_lie_stable hPr D ψ θ W W₁ X A A₁ B α β ν 𝓕 ν₁ 𝓕₁ ωA ωB e Bs Γ Xc om om' cA cB hθ hTr hO hT Pi rf rl p p' hM
        γ hγ g₀ hg₀ x hx1 hD φ hφ hv
    | zero => rw [pure_zero']; exact Submodule.zero_mem _
    | add x y _ _ hx hy => rw [pure_add']; exact Submodule.add_mem _ hx hy
    | smul c x _ hx => rw [pure_smul']; exact Submodule.smul_mem _ c hx
  have := key _ hS
  rwa [pure_sub'] at this
