theorem exists_rational_move_of_jets : FunPr.ThetaLocalInputs → (∀ D, NormSum.Inp D) → ∀ {D : D7} {Γ : Type} [Group Γ] [Fintype Γ] {Pl0 T : Type}
    {A : FamIn D.what₂.LL Γ Pl0 T D.R.m} {Ks : Type} [Field Ks] [NumberField Ks] [Algebra Ks D.what₂.LL] {R : RealDat D A Ks}
    (ch : Choice R), ch.Is → ∀ (p : Pair T), DefPair D.R.m p → ∀ (x : FinPt ch.G p.small) (y : FinPt ch.G p.big) (κ : ℂ), MovedKappaEx.JetKap ch p x y κ →
    ∀ (r : FinPt ch.G p.small) (r' : FinPt ch.G p.big), MovedKappaEx.RatFin _ r → MovedKappaEx.RatFin _ r' →
    ∃ c : ℂ, Mod1All c ∧ (∀ (q : ℕ) [Fact q.Prime],
        EqAt D q (SumSize.latAt ch.S.toGridChoice p.small x) (stdL D _) → EqAt D q (SumSize.latAt ch.S.toGridChoice p.big y) (stdL D _) →
        EqAt D q (SumSize.latAt ch.S.toGridChoice p.small (r * x)) (stdL D _) → EqAt D q (SumSize.latAt ch.S.toGridChoice p.big (r' * y)) (stdL D _) →
        MovedKappaEx.UnitAt q c) ∧
      MovedKappaEx.JetKap ch p (r * x) (r' * y) (c * κ) := by
  intro hP hI D Γ _ _ Pl0 T A Ks _ _ _ R ch hch p hp x y κ hJ r r' hr hr'
  obtain ⟨hns, hnb⟩ := hp.nodes
  obtain ⟨U, hU⟩ := GlobalTheory.T.exists_unitaryCoordinate_of_rationalPoint_definiteVertex ch.S.toGridChoice _ hns r hr
  obtain ⟨U', hU'⟩ := GlobalTheory.T.exists_unitaryCoordinate_of_rationalPoint_definiteVertex ch.S.toGridChoice _ hnb r' hr'
  have hlx := GlobalTheory.T.vertexLatticeCoords_rationalPoint_mul_eq_coordMatrix ch.S.toGridChoice _ r U hU x
  have hly := GlobalTheory.T.vertexLatticeCoords_rationalPoint_mul_eq_coordMatrix ch.S.toGridChoice _ r' U' hU' y
  have hd := MovedDict.Entire.differentiable_moved_operator_eval hP hI ch hch p hp x y
  obtain ⟨ε, hm, hu, hj⟩ := _root_.GlobalTheory.T.twist_fock_jetTheta_rational hP hI ch hch p hp x y _ (hd.const_mul κ) ((jetKap_iff ch p x y κ).1 hJ) r r' U U' hU hU'
  obtain ⟨hsd, hsd'⟩ := MovedSD.moved_series_decomposition hP hI ch hch p hp x y
  obtain ⟨ε', hm', hu', hB⟩ := _root_.GlobalTheory.T.twist_pairing_rational_pullback_eq hP hI ch.S.Z.crv ch.S.Z.pt0 (ch.S.Z.e0_is p hp) (FunObj.even_rank_mul ch.G p hp) _ _
    hsd hsd' (srcU p U U') (tgtU p U U')
  have hst : MovedDict.srcLat ch.S.toGridChoice p (r * x) (r' * y) =
        SDLat.smulLat (srcU p U U').1 (MovedDict.srcLat ch.S.toGridChoice p x y) ∧
      MovedDict.tgtLat ch.S.toGridChoice p (r * x) (r' * y) =
        SDLat.smulLat (tgtU p U U').1 (MovedDict.tgtLat ch.S.toGridChoice p x y) := by
    cases p <;> exact ⟨by first | exact hlx | exact hly, by first | exact hlx | exact hly⟩
  have hq : ∀ (q : ℕ) [Fact q.Prime],
      EqAt D q (SumSize.latAt ch.S.toGridChoice p.small x) (stdL D _) → EqAt D q (SumSize.latAt ch.S.toGridChoice p.big y) (stdL D _) →
      EqAt D q (SumSize.latAt ch.S.toGridChoice p.small (r * x)) (stdL D _) → EqAt D q (SumSize.latAt ch.S.toGridChoice p.big (r' * y)) (stdL D _) →
      MovedKappaEx.UnitAt q ε' := by
    intro q _ h1 h2 h3 h4
    rw [hlx] at h3
    rw [hly] at h4
    cases p <;> first
      | exact hu' q h2 h1 h4 h3
      | exact hu' q h1 h2 h3 h4
  refine ⟨ε * ε', FamilyTieProof.mod1All_mul' hm hm', fun q _ h1 h2 h3 h4 => unitAt_mul hm hm' (hu q h1 h2 h3 h4) (hq q h1 h2 h3 h4), ?_⟩
  rw [jetKap_iff, hst.1, hst.2]
  have e : (fun z => ε * ((fun z => κ * Iop D (tor0 D D.host.ccK ch.S.Z.δ) (La0 D (tor0 D D.host.ccK ch.S.Z.δ) _ _)
      (Formalism.MainNotions.TaylorLogMetric.La D (tor0 D D.host.ccK ch.S.Z.δ) (MovedDict.srcLat ch.S.toGridChoice p x y)
        (MovedDict.tgtLat ch.S.toGridChoice p x y)) (ch.S.Z.e0 p) z)
        (Formalism.L2.KerInert.tPull D (tor0 D D.host.ccK ch.S.Z.δ) (srcU p U U').1 (tgtU p U U').1 z))) =
      fun z => ε * ε' * κ * Iop D (tor0 D D.host.ccK ch.S.Z.δ) (La0 D (tor0 D D.host.ccK ch.S.Z.δ) _ _)
        (Formalism.MainNotions.TaylorLogMetric.La D (tor0 D D.host.ccK ch.S.Z.δ) (SDLat.smulLat (srcU p U U').1 (MovedDict.srcLat ch.S.toGridChoice p x y))
          (SDLat.smulLat (tgtU p U U').1 (MovedDict.tgtLat ch.S.toGridChoice p x y))) (ch.S.Z.e0 p) z := by
    funext z
    simp only
    rw [hB z]
    ring
  rw [e] at hj
  intro k
  rw [hj k]
end GlobalTheory.RatMoveJets
end
