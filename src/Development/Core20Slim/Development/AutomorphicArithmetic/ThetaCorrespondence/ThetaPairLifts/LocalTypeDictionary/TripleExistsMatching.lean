namespace GlobalTheory.TripleRead
theorem triple_exists_matching : Published.HoweDualityReal → FunPr.ThetaLocalInputs → IndefiniteRowSideFullHecke.WeilTensorModels.ThetaIntegralsAgree → IndefiniteRowSideFullHecke.WeilTensorModels.LocalMatching →
  ∀ (D : D7) (ψ : AddChar (AF D.host.F) ℂ) (θ : InfFam D), IsStdChar D ψ (-1) → IsInfFam θ →
    ∀ (W W₁ X : HSp D) (A : Fr W) (A₁ : Fr W₁) (B : Fr X) (α β : (AE D)ˣ →* Circle), IsTriple W W₁ X α β →
      ∃ ωA ωB Pi rf rl p p', IsMatch ψ θ A A₁ B α β ωA ωB Pi rf rl p p' := by
  intro hH hP _ hLM D ψ θ hψ hθ W W₁ X A A₁ B α β hT
  obtain ⟨ωA, ωB, hA, hB⟩ := T.weilRepresentation_square_comm hP D ψ hψ W W₁ X α β hT
  obtain ⟨e, Bs, Γ, Xc, om, om', h, hTr, htA, htB⟩ := T.exists_darboux_coordinates_triple hP D ψ hψ W W₁ X A A₁ B α β hT ωA ωB hA hB
  obtain ⟨R, Rf, hM⟩ := hLM D.host.F D.host.E D.sp.cm.sig Bs W.rank W₁.rank Γ Xc om om' hTr
  obtain ⟨Pi, rf, rl, p, p', hm⟩ :=
    T.exists_matching_triple_for_theta_lift hH hP D ψ θ hψ hθ W W₁ X A A₁ B α β hT ωA ωB hA hB e Bs Γ Xc om om' h htA htB R Rf hM
  exact ⟨ωA, ωB, Pi, rf, rl, p, p', hm⟩
end GlobalTheory.TripleRead
end
