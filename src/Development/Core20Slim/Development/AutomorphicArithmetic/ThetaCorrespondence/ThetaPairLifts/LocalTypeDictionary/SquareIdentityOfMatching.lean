    Grid.IsWeil W.ψ true _ _ (IndefiniteRowSideFullHecke.UnitaryConjugation.beta G i j) ((IndefiniteRowSideFullHecke.UnitaryConjugation.beta G i j) / (IndefiniteRowSideFullHecke.UnitaryConjugation.alpha G t i j)) ωA → Grid.IsWeil W.ψ false _ _ (IndefiniteRowSideFullHecke.UnitaryConjugation.alpha G t i j) ((IndefiniteRowSideFullHecke.UnitaryConjugation.alpha G t i j) / (IndefiniteRowSideFullHecke.UnitaryConjugation.beta G i j)) ωB →
    ∃ Pi rf rl p p', SquareComm.IsMatch W.ψ W.θ A A₁ (SquareComm.frSum AV AV₁) (IndefiniteRowSideFullHecke.UnitaryConjugation.alpha G t i j) (IndefiniteRowSideFullHecke.UnitaryConjugation.beta G i j) ωA ωB Pi rf rl p p' ∧
      ∀ P, ∃ P', ∀ n Φ (τ : TotT G (routeBig t i j)) (τ' : TotT G (routeSmall t i j)),
        (∀ w ∈ locPl G t, depthAt G w ≤ n w ∧ IsNatDatum (unifAt w) (n w) (Φ w)) → HasFlip B t ρ i j n Φ τ τ' →
        SquareComm.IsFinF W.ψ W.θ true A (SquareComm.frSum AV AV₁) (SquareDict.datumA W τ) ∧
        SquareComm.IsFinF W.ψ W.θ false A₁ (SquareComm.frSum AV AV₁) (SquareDict.datumB W τ') ∧
        p (SquareComm.fockF W.ψ W.θ true A (SquareComm.frSum AV AV₁) (SquareDict.datumA W τ) P) =
          p' (SquareComm.fockF W.ψ W.θ false A₁ (SquareComm.frSum AV AV₁) (SquareDict.datumB W τ') P') := by
  intro hH hP hTL D T L sc G μ₀ hL W i j A A₁ AV AV₁ hA hA₁ hV hV₁ t B ρ M hst hM hT ωA ωB hωA hωB
  obtain ⟨h1, h2⟩ := FlipMatch.flip_match hL W B ρ t i j hst M
  obtain ⟨e, Bs, Γ, X, om₀, om₀', h, hT₀, hti⟩ := h1 hM
  have hR : IsReading W.ψ A A₁ (SquareComm.frSum AV AV₁) _ _ (e.symm.trans finSumFinEquiv) Bs Γ X :=
    ⟨h.ψ, h.JW, h.JW₁, by
      rw [h.JWW, IndefiniteRowSideFullHecke.UnitaryConjugation.skewGram, ← IndefiniteRowSideFullHecke.UnitaryConjugation.blk_transpose, ← blkMat_submatrix, Doubling.gram_hsum]
      rfl, fun w => by
      obtain ⟨τ, a, b, c, d⟩ := h.cart w
      refine ⟨τ, a, b.trans (hA τ).2.symm, c.trans (congrArg Neg.neg (hA₁ τ).2.symm), d.trans ?_⟩
      rw [SquareAlg.cart_frSum, (hV τ).2, (hV₁ τ).2, ← blkMat_submatrix], h.α, h.β⟩
  obtain ⟨om, om', R, Rf, hm, Pi, rf, rl, p, p', hM', H⟩ := SquareIdent.square_identity_pure_match hH hP hTL W.θ_is A A₁ _ hT hωA hωB hR hT₀
  obtain ⟨f₀, f₀', ⟨-, g1⟩, ⟨n2, g2⟩, hfl⟩ := h2 e Bs Γ X om om' h hti R Rf hm
  refine ⟨Pi, rf, rl, p, p', hM', fun P => ?_⟩
  obtain ⟨P', hP'⟩ := H f₀ f₀' g1 n2 g2 P
  refine ⟨P', fun n Φ τ τ' hn hF => ?_⟩
  obtain ⟨φ, φ', p1, q1, dA, dB, hv, -⟩ := hfl n Φ τ τ' hn hF
  exact hP' φ φ' p1 q1 hv _ _ (isDatum_of_isDatumA dA) (isDatum_of_isDatumB dB)
