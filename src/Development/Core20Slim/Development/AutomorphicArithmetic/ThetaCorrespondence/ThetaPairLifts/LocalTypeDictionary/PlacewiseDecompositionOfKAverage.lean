theorem placeDecomposition_kAverage : ∀ (D : D7) (θ : InfFam D), IsInfFam θ → FunPr.ThetaLocalInputs → ∀ (N : Grid.Node D) (U : Subgroup (GA D N.V)) (W : D.what₂.Tau → Type) [∀ τ, AddCommGroup (W τ)] [∀ τ, Module ℂ (W τ)] [∀ τ, FiniteDimensional ℂ (W τ)] (ρ : ∀ τ, Representation ℂ (Formalism.REAL.KG (N.M.ε τ)) (W τ)) (τ : D.what₂.Tau) (e : Formalism.REAL.KG (N.M.ε τ) → ℂ), KFinFun (N.M.ε τ) e → HasCtp θ N U (TyOf θ N ρ) τ (kAvg (N.M.ε τ) (N.M.σ τ) e) := by
  intro D θ hθ hp N U W _ _ _ ρ τ e he
  haveI : CompleteSpace (N.M.H τ) := (N.M.ds τ).1
  haveI : IsTopologicalGroup (GA D N.V) := Formalism.L2.GlobalTheoryTheory.GenusMassVolumes.Unfold.topGroupHA _ _
  have hP := N.M.fr_unit τ
  have hJ := N.M.fr_gram τ
  have hσ : Std (N.M.ε τ) (N.M.σ τ) := std_of_isDS hp.harishChandraModules (N.M.ds τ)
  have hec : Continuous e := by obtain ⟨F, -, h1, h2, -⟩ := he; exact h2 _ h1
  have hU : ∀ k, (N.M.fr τ)⁻¹ * toMK k * N.M.fr τ ∈ Formalism.QuantumDeterminants.UH (gramAt D N.V τ) :=
    fun k => Published.AutFin.conj_mem_UH hP hJ k
  have hκ := SeriesToClosure.continuous_conjK (ε := N.M.ε τ) (P := N.M.fr τ)
  have hA : ∀ f, SeriesToClosure.avg θ N.V τ (N.M.ε τ) (N.M.fr τ) e f =
      AvgOtherPlace.avgF θ N.V (muK (N.M.ε τ)) τ (fun k => (N.M.fr τ)⁻¹ * toMK k * N.M.fr τ) e f := fun f => rfl
  refine ⟨SeriesToClosure.avg θ N.V τ (N.M.ε τ) (N.M.fr τ) e, ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩,
    fun φ _ => SeriesToClosure.moves_avg hθ hP hJ hσ he φ⟩
  · intro f hf
    exact KFinAvgSpan.continuous_avg hθ hP hJ hec hf
  · intro f f' hf hf'
    rw [hA, hA, hA]
    exact AvgOtherPlace.avgF_add _ hθ hκ hU hec hf hf'
  · intro c f _
    rw [hA, hA]
    exact AvgOtherPlace.avgF_smul _ c f
  · intro f hf
    refine ⟨AvgCuspType.cusp_average_isCuspOfType D θ hθ hp N f hf.1 τ e he, fun k hk hkf g => ?_⟩
    simp only [SeriesToClosure.avg]
    congr 1
    funext k'
    rw [mul_assoc, ← PointAtPlaceHom.comm_of_mem N.V (PointAtPlaceHom.atTau_mem N.V τ _) hkf, ← mul_assoc,
      hf.2 k hk hkf]
  · intro τ' hne f hf hT x
    haveI := AvgCoeff.coeffSpan_finiteDimensional (ρ τ')
    have hAc : Continuous fun k' : KG (N.M.ε τ) => atTau θ N.V τ ((N.M.fr τ)⁻¹ * toMK k' * N.M.fr τ) :=
      RealAverage.continuous_atTau hθ hκ hU
    have hc : ∀ k k', Published.AutFin.kAt θ N.V τ' (N.M.ε τ') (N.M.fr τ') k *
        atTau θ N.V τ ((N.M.fr τ)⁻¹ * toMK k' * N.M.fr τ) =
        atTau θ N.V τ ((N.M.fr τ)⁻¹ * toMK k' * N.M.fr τ) * Published.AutFin.kAt θ N.V τ' (N.M.ε τ') (N.M.fr τ') k :=
      fun k k' => PointAtPlaceComm.atTau_comm D θ hθ N.V τ' τ hne _
        (Published.AutFin.conj_mem_UH (N.M.fr_unit τ') (N.M.fr_gram τ') k) _ (hU k')
    have hcont : ∀ k, Continuous fun k' : KG (N.M.ε τ) => e k' *
        f (x * atTau θ N.V τ ((N.M.fr τ)⁻¹ * toMK k' * N.M.fr τ) * Published.AutFin.kAt θ N.V τ' (N.M.ε τ') (N.M.fr τ') k) :=
      fun k => hec.mul (hf.1.1.cont.comp ((continuous_const.mul hAc).mul continuous_const))
    have key := AvgCoeff.integral_mem (muK (N.M.ε τ)) (Published.AutFin.coeffSpan (ρ τ'))
      (fun k' k => e k' * f (x * atTau θ N.V τ ((N.M.fr τ)⁻¹ * toMK k' * N.M.fr τ) *
        Published.AutFin.kAt θ N.V τ' (N.M.ε τ') (N.M.fr τ') k))
      (fun k' => Submodule.smul_mem _ (e k') (hT _)) (fun k => ExpansionAverage.integrable_K (hcont k))
    have heq : (fun k => SeriesToClosure.avg θ N.V τ (N.M.ε τ) (N.M.fr τ) e f
        (x * Published.AutFin.kAt θ N.V τ' (N.M.ε τ') (N.M.fr τ') k)) =
        fun k => ∫ k', e k' * f (x * atTau θ N.V τ ((N.M.fr τ)⁻¹ * toMK k' * N.M.fr τ) *
          Published.AutFin.kAt θ N.V τ' (N.M.ε τ') (N.M.fr τ') k) ∂(muK (N.M.ε τ)) := by
      funext k
      simp only [SeriesToClosure.avg]
      congr 1
      funext k'
      rw [mul_assoc, hc, ← mul_assoc]
    show (fun k => SeriesToClosure.avg θ N.V τ (N.M.ε τ) (N.M.fr τ) e f
        (x * Published.AutFin.kAt θ N.V τ' (N.M.ε τ') (N.M.fr τ') k)) ∈ _
    rw [heq]
    exact key
  · intro τ' hne g hg f _
    funext x
    simp only [SeriesToClosure.avg, rTr]
    congr 1
    funext k
    rw [mul_assoc x, mul_assoc x, AvgOtherPlace.atTau_comm hθ hne (hU k) hg]
  · intro τ' hne X hX f hf
    rw [hA, hA]
    exact (AvgOtherPlace.avgF_Rder _ hθ hne hκ hU hec hf.1.1 hX).symm
end GlobalTheory.PlaceDecomp
end
