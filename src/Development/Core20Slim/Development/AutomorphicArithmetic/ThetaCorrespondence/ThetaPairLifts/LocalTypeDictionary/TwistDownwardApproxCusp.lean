  first | exact @_root_.GlobalTheory.DownApprox.downward_approx_cusp | exact _root_.GlobalTheory.DownApprox.downward_approx_cusp | (intros; apply _root_.GlobalTheory.DownApprox.downward_approx_cusp <;> assumption)
