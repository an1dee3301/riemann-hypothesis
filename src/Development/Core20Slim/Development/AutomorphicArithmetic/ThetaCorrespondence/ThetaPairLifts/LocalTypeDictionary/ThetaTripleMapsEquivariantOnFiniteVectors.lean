theorem theta_triple_maps_equivariant_on_finite_vectors : Published.HoweDualityReal → FunPr.ThetaLocalInputs →
    ∀ (D : D7) (ψ : AddChar (AF D.host.F) ℂ) (θ : InfFam D), IsStdChar D ψ (-1) → IsInfFam θ →
    ∀ (W W₁ X : HSp D) (A : Fr W) (A₁ : Fr W₁) (B : Fr X) (α β : (AE D)ˣ →* Circle), IsTriple W W₁ X α β →
    ∀ (ωA : WRep W X) (ωB : WRep W₁ X), IsWeil ψ true W X β (β / α) ωA → IsWeil ψ false W₁ X α (α / β) ωB →
    ∀ (e : Fin (W.rank + W₁.rank) ≃ Fin X.rank) (Bs : IndefiniteRowSideFullHecke.WeilTensorModels.Base D.host.F D.host.E)
      (Γ : IndefiniteRowSideFullHecke.WeilTensorModels.Geo D.sp.cm.sig W.rank W₁.rank) (Xc : IndefiniteRowSideFullHecke.WeilTensorModels.Chars D.host.F D.host.E)
      (om : IndefiniteRowSideFullHecke.WeilTensorModels.Rep D.sp.cm.sig Γ.V Γ.W) (om' : IndefiniteRowSideFullHecke.WeilTensorModels.Rep D.sp.cm.sig Γ.V' Γ.W)
      (h : TripleRead.IsReading ψ A A₁ B α β e Bs Γ Xc),
      TripleRead.IsTransp ψ true Γ.M om ωA e (IndefiniteRowSideFullHecke.UnitaryConjugation.conjU W 1 h.JW) (TripleRead.toUX X e h.JX) →
      TripleRead.IsTransp ψ false Γ.M' om' ωB e (IndefiniteRowSideFullHecke.UnitaryConjugation.conjU W₁ (-1) h.JW₁) (TripleRead.toUX X e h.JX) →
      ∀ R Rf, IndefiniteRowSideFullHecke.WeilTensorModels.IsMatched Bs Γ Xc om om' R Rf →
        (∀ g ∈ GfC X, ∀ Φ ∈ algF ψ θ true A B, mapA ψ e Bs Γ R Rf (ωA (1, g) Φ) = opFin ωA (algF ψ θ true A B) (mapA ψ e Bs Γ R Rf) g (mapA ψ e Bs Γ R Rf Φ)) ∧
          ∀ g ∈ GfC X, ∀ Φ ∈ algF ψ θ false A₁ B, mapB ψ e Bs Γ R Rf (ωB (1, g) Φ) = opFin ωA (algF ψ θ true A B) (mapA ψ e Bs Γ R Rf) g (mapB ψ e Bs Γ R Rf Φ) := by
  intro hH hP D ψ θ hψ hθ W W₁ X A A₁ B α β hT ωA ωB hA hB e Bs Γ Xc om om' h hTA hTB R Rf hM
  obtain ⟨oA, -⟩ := _root_.GlobalTheory.T.triple_algebra_map_surjective hH hP D ψ θ hψ hθ W W₁ X A A₁ B α β hT ωA ωB hA hB e Bs Γ Xc om om' h hTA hTB R Rf hM
  obtain ⟨⟨dA, rA⟩, ⟨dB, rB⟩⟩ :=
    _root_.GlobalTheory.T.triple_twist_transport hH hP D ψ θ hψ hθ W W₁ X A A₁ B α β hT ωA ωB hA hB e Bs Γ Xc om om' h hTA hTB R Rf hM
  have gM : Γ.M.IsGood Bs.ψ := hM.triple.geo.hM
  have gM' : Γ.M'.IsGood Bs.ψ := hM.triple.geo.hM'
  have c1 : IndefiniteRowSideFullHecke.UnitaryConjugation.conjU W 1 h.JW 1 = 1 := Subtype.ext ((congrArg _ (map_one (matHom W))).trans (map_one _))
  have c1' : IndefiniteRowSideFullHecke.UnitaryConjugation.conjU W₁ (-1) h.JW₁ 1 = 1 := Subtype.ext ((congrArg _ (map_one (matHom W₁))).trans (map_one _))
  have hsA : ∀ᶠ v in Filter.cofinite, Rf.p v (Γ.M.vac v) = vacIm Γ Rf v :=
    Filter.Eventually.of_forall fun v => rfl
  have hsB : ∀ᶠ v in Filter.cofinite, Rf.p' v (Γ.M'.vac v) = vacIm Γ Rf v := by
    refine Filter.eventually_cofinite.2 ((Xc.T.finite_toSet).subset fun v hv => ?_)
    by_contra hn
    exact hv (hM.fin.sph v hn).1.symm
  have key : ∀ g ∈ GfC X, ∃ T : Module.End ℂ (PiT R Γ Rf),
      (∀ Φ ∈ algF ψ θ true A B, mapA ψ e Bs Γ R Rf (ωA (1, g) Φ) =
        T (mapA ψ e Bs Γ R Rf Φ)) ∧
      ∀ Φ ∈ algF ψ θ false A₁ B, mapB ψ e Bs Γ R Rf (ωB (1, g) Φ) =
        T (mapB ψ e Bs Γ R Rf Φ) := by
    intro g hg
    obtain ⟨hv, hvU, fA, fB⟩ := _root_.GlobalTheory.T.theta_pure_tensor_placewise_finite hP D W W₁ X e Bs Γ Xc om om' R Rf hM h.JX g hg
    choose a ha using fun v => GlobalTheory.T.exists_localOperator_thetaQuotient_finitePlace D.sp.cm.sig W.rank W₁.rank Bs Γ Xc om om' R Rf hM v (hv v) (hvU v)
    obtain ⟨T₀, hT₀⟩ := exists_rtensOp (vacIm Γ Rf) a
    refine ⟨LinearMap.lTensor R.Pi T₀, ?_, ?_⟩
    · have st := darbAlg_stable Γ.M Bs.ψ Bs.emb gM R.p Rf.p (vacIm Γ Rf) hsA
        (om (1, TripleRead.toUX X e h.JX g)) T₀ (fun f φ hφ hφv => by
          obtain ⟨φ₁, h1, h1v, hAct, hO⟩ := fA f φ hφ hφv
          refine ⟨φ₁, h1, h1v, hO, ?_⟩
          rw [hT₀ _ (Filter.eventually_cofinite.1 ((hφv.and hsA).mono fun v hv' => by rw [hv'.1, hv'.2]))]
          congr 1
          funext v
          exact (ha v).1 (φ v) (hφ v) (φ₁ v) (h1 v) (hAct v))
      intro Φ hΦ
      obtain ⟨Ψ, hΨ, rfl⟩ := rA Φ hΦ
      have hs := darbAlg_le_schA D.sp.cm.sig Γ.V Γ.W Γ.M Bs.ψ Bs.emb gM hΨ
      have e1 := hTA Ψ hs 1 g
      rw [c1] at e1
      have s1 := (st Ψ hΨ).1
      have s2 := (st Ψ hΨ).2
      have d1 := dA _ s1
      have d2 := dA Ψ hΨ
      have x1 := congrArg (mapA ψ e Bs Γ R Rf) e1.symm
      have x2 := congrArg (LinearMap.lTensor R.Pi T₀) d2.symm
      exact x1.trans (d1.trans (s2.trans x2))
    · have st := darbAlg_stable Γ.M' Bs.ψ Bs.emb gM' R.p' Rf.p' (vacIm Γ Rf) hsB
        (om' (1, TripleRead.toUX X e h.JX g)) T₀ (fun f φ hφ hφv => by
          obtain ⟨φ₁, h1, h1v, hAct, hO⟩ := fB f φ hφ hφv
          refine ⟨φ₁, h1, h1v, hO, ?_⟩
          rw [hT₀ _ (Filter.eventually_cofinite.1 ((hφv.and hsB).mono fun v hv' => by rw [hv'.1, hv'.2]))]
          congr 1
          funext v
          exact (ha v).2 (φ v) (hφ v) (φ₁ v) (h1 v) (hAct v))
      intro Φ hΦ
      obtain ⟨Ψ, hΨ, rfl⟩ := rB Φ hΦ
      have hs := darbAlg_le_schA D.sp.cm.sig Γ.V' Γ.W Γ.M' Bs.ψ Bs.emb gM' hΨ
      have e1 := hTB Ψ hs 1 g
      rw [c1'] at e1
      exact (congrArg (mapB ψ e Bs Γ R Rf) e1.symm).trans ((dB _ (st Ψ hΨ).1).trans
        (((st Ψ hΨ).2).trans (congrArg (LinearMap.lTensor R.Pi T₀) (dB Ψ hΨ).symm)))
  have opEq : ∀ g, ∀ T : Module.End ℂ (PiT R Γ Rf),
      (∀ Φ ∈ algF ψ θ true A B, mapA ψ e Bs Γ R Rf (ωA (1, g) Φ) =
        T (mapA ψ e Bs Γ R Rf Φ)) →
      opFin ωA (algF ψ θ true A B) (mapA ψ e Bs Γ R Rf) g = T := by
    intro g T hTg
    have H : ∃ T : Module.End ℂ (PiT R Γ Rf), ∀ Φ ∈ algF ψ θ true A B,
        mapA ψ e Bs Γ R Rf (ωA (1, g) Φ) = T (mapA ψ e Bs Γ R Rf Φ) := ⟨T, hTg⟩
    unfold opFin
    rw [dite_eq_left H]
    apply LinearMap.ext
    intro y
    have hy : y ∈ (algF ψ θ true A B).map (mapA ψ e Bs Γ R Rf) := by rw [oA]; trivial
    obtain ⟨Φ, hΦ, rfl⟩ := hy
    rw [← H.choose_spec Φ hΦ, hTg Φ hΦ]
  refine ⟨fun g hg Φ hΦ => ?_, fun g hg Φ hΦ => ?_⟩
  · obtain ⟨T, h1, -⟩ := key g hg
    rw [opEq g T h1]
    exact h1 Φ hΦ
  · obtain ⟨T, h1, h2⟩ := key g hg
    rw [opEq g T h1]
    exact h2 Φ hΦ
end GlobalTheory.TripleAssembly.EqFin
