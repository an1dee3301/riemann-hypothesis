theorem hasDerivAt_theta_sum_along_line : FunPr.ThetaLocalInputs → ∀ {F E : Type} [Field F] [NumberField F] [Field E] [NumberField E] [Algebra F E] {σ : E →ₐ[F] E} {n d : ℕ}
    {Y : IndefiniteRowSideFullHecke.WeilTensorModels.Spc F E n} {Wd : IndefiniteRowSideFullHecke.WeilTensorModels.Spc F E d} (M : IndefiniteRowSideFullHecke.WeilTensorModels.Model σ Y Wd) (ψ : AddChar (AF F) ℂ)
    (χX χW : IndefiniteRowSideFullHecke.WeilTensorModels.Chr F E) (om : IndefiniteRowSideFullHecke.WeilTensorModels.Rep σ Y Wd),
    Formalism.MainNotions.GlobalTheoryTheory.GenusMassVolumes.IsCMExt F E σ →
    IndefiniteRowSideFullHecke.WeilTensorModels.IsStd ψ → M.IsGood ψ → M.IsWeil ψ χX χW om →
    ∀ γ ∈ IndefiniteRowSideFullHecke.WeilTensorModels.Lines σ Wd, ∀ (m : ℕ) (f f₁ : Fin m → IndefiniteRowSideFullHecke.WeilTensorModels.SInf F (Fin n × Fin d))
      (φ : Fin m → ∀ v : IndefiniteRowSideFullHecke.WeilTensorModels.Pl (F := F), (Fin n × Fin d → Fv F v) → ℂ),
    (∀ i, (∀ v, φ i v ∈ WeilM.SB _) ∧ ∀ᶠ v in Filter.cofinite, φ i v = M.vac v) →
    (∀ i, IndefiniteRowSideFullHecke.WeilTensorModels.ActsD (IndefiniteRowSideFullHecke.WeilTensorModels.evI F) (fun t => om (1, γ (Multiplicative.ofAdd t))) (f i) (f₁ i)) →
    ∀ u, HasDerivAt (fun t : ℝ => WeilM.thetaSum F (M.co.rho ψ u (om (1, γ (Multiplicative.ofAdd t)) (∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (f i) (φ i)))))
      (WeilM.thetaSum F (M.co.rho ψ u (∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (f₁ i) (φ i)))) 0 := by
  intro hP F E _ _ _ _ _ σ n d Y Wd M ψ χX χW om hcm hψ hG hW γ hγ m f f₁ φ hφ hD u
  have hstd : ∀ i, ∀ᶠ v in Filter.cofinite, φ i v = Set.indicator {x | ∀ j, x j ∈ v.adicCompletionIntegers F} 1 :=
    fun i => ((hφ i).2.and hG.std).mono fun v h => h.1.trans h.2
  have hmem : ∀ i (g : IndefiniteRowSideFullHecke.WeilTensorModels.SInf F (Fin n × Fin d)), IndefiniteRowSideFullHecke.WeilTensorModels.pure g (φ i) ∈ WeilM.schA F (Fin n × Fin d) :=
    fun i g => TensUniq.pure_mem_schA g (φ i) (hφ i).1 (hstd i)
  choose c g hcg using fun i => T.twisted_smoothLine_pure_weight hP M ψ χX χW om hcm hψ hG hW γ hγ (f i) (φ i) (hφ i).1 (hφ i).2
  have hc := fun i => (hcg i).1
  have hlim := fun i => (hcg i).2
  choose Λ hΛ using fun i => ThetaHeisCLM.exists_clm_thetaSum_rho_pure M ψ hψ hG u (φ i) (hφ i).1 (hφ i).2
  have hcurve : (fun t : ℝ => WeilM.thetaSum F (M.co.rho ψ u (om (1, γ (Multiplicative.ofAdd t)) (∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (f i) (φ i)))))
      = fun t => ∑ i, Λ i (c i t) := by
    funext t
    set_option synthInstance.maxHeartbeats 100000 in
      rw [map_sum]
    simp only [hc]
    rw [rho_sum M ψ hψ u _ (fun i => hmem i _)]
    simp only [hΛ]
  have hg : ∀ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (g i) (φ i) = IndefiniteRowSideFullHecke.WeilTensorModels.pure (f₁ i) (φ i) := by
    intro i
    funext x
    have hR := ThK.EvUniqInf.rest_pure (f i) (φ i) (hφ i).1 (hstd i)
    have h1 := hD i _ hR x
    have ev : Continuous fun s : IndefiniteRowSideFullHecke.WeilTensorModels.SInf F (Fin n × Fin d) => s (fun j => evI F (x j)) :=
      by
        have h1 := (SchwartzMap.toBoundedContinuousFunctionCLM ℂ (Fin n × Fin d → mixedEmbedding.mixedSpace F) ℂ).continuous
        have h2 := (continuous_eval_const (F := BoundedContinuousFunction (Fin n × Fin d → mixedEmbedding.mixedSpace F) ℂ)
          (fun j => evI F (x j))).comp h1
        exact h2
    have h2 : HasDerivAt (fun t : ℝ => c i t (fun j => evI F (x j)) * ∏ᶠ v, φ i v fun j => evFin F v (x j))
        (g i (fun j => evI F (x j)) * ∏ᶠ v, φ i v fun j => evFin F v (x j)) 0 := by
      rw [hasDerivAt_iff_tendsto_slope]
      exact (((ev.tendsto (g i)).comp (hlim i)).mul_const _).congr' (Filter.Eventually.of_forall fun t => schwartz_diffQuotient_eval_mul_eq_slope _ _ _ t)
    have h3 : (fun t : ℝ => c i t (fun j => evI F (x j)) * ∏ᶠ v, φ i v fun j => evFin F v (x j)) =
        fun t => om (1, γ (Multiplicative.ofAdd t)) (IndefiniteRowSideFullHecke.WeilTensorModels.tens (evI F) (⇑(f i)) (fun x => ∏ᶠ v, φ i v fun j => evFin F v (x j))) x := by
      funext t
      show IndefiniteRowSideFullHecke.WeilTensorModels.pure (c i t) (φ i) x = om (1, γ (Multiplicative.ofAdd t)) (IndefiniteRowSideFullHecke.WeilTensorModels.pure (f i) (φ i)) x
      rw [hc i t]
    rw [h3] at h2
    exact h2.unique h1
  have hend : WeilM.thetaSum F (M.co.rho ψ u (∑ i, IndefiniteRowSideFullHecke.WeilTensorModels.pure (f₁ i) (φ i))) = ∑ i, Λ i (g i) := by
    rw [rho_sum M ψ hψ u _ (fun i => hmem i _)]
    simp only [← hg, hΛ]
  have hc0 : ∀ i, HasDerivAt (fun t => Λ i (c i t)) (Λ i (g i)) 0 := by
    intro i
    rw [hasDerivAt_iff_tendsto_slope]
    refine ((Λ i).continuous.tendsto (g i) |>.comp (hlim i)).congr' (Filter.Eventually.of_forall fun t => ?_)
    simp [slope_def_module, map_sub, map_smul]
  rw [hcurve, hend]
  have := HasDerivAt.sum (u := Finset.univ) fun i _ => hc0 i
  simpa [Finset.sum_fn] using this
end GlobalTheory.ThetaLineDer
