theorem setting_of_size_alt (p : PtAt ex Csz) (hp : p.PointConditions') (hs : IndefiniteRowSideFullHecke.LevelPlusSubgroup.SizeRows L) (he : GLq.ESerTie D) :
    HidaSetting L p.R.toRealDat p.F.lv2 :=
  { size := hs
    eser := he
    host := p.host
    hF := p.hF
    core := (OneMapBridge.heckeChoiceClauses_of_weakCharacterisation_at_face D _ _ _ _ _ _ p.R p.F p.charW hp.exAt).1
    mu_off := p.charW.tup.mu_off
    mu_used := p.charW.tup.mu_used
    mu_ne := p.charW.tup.mu_ne
    mu_conj := p.charW.tup.mu_conj
    mu_on := p.charW.tup.mu_on
    grp := p.charW.base.grp.record
    guard := p.qGuard
    fin := finite_tup p
    fullY := p.charW.fullY
    fullX := p.charW.fullX
    std := p.stdChar
    stdX := p.stdX
    betaX := p.betaStd.2 }
end GlobalTheory.BigTop.Fun.SetFromSize
