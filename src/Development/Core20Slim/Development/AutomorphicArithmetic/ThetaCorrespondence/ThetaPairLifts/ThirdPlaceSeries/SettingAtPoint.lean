def SizeAtAlt : Prop := Closed FamHyp fun Fm _ => EventuallyAtPoints Fm fun x _ i _ => IndefiniteRowSideFullHecke.LevelPlusSubgroup.SizeRows (Fm.L x i)
def SettingAtPoint : Prop := Closed FamHyp fun Fm _ => EventuallyAtPoints Fm fun x _ i p =>
  GLq.ESerTie (Fm.D x i) → HidaSetting (Fm.L x i) p.R.toRealDat p.F.lv2
def CharacterAtPoint (Q : ChP) : Prop := ∃ CF0 : ℝ, ∀ CF, CF0 ≤ CF → Closed FamHyp fun Fm _ => EventuallyAtPoints Fm fun _ _ _ p =>
  ∀ (G : Grid p CF) (W : G.Weil) (n : ℕ) (a : SlopeTestRemainingChoices p G W n), a.OK → Q a.ch
theorem SettingAtPoint.atPt (h : SettingAtPoint) {Q : ChP} (hQ : Big Q) : CharacterAtPoint Q := by
  obtain ⟨c, hQ⟩ := hQ
  refine ⟨c, fun CF hCF => h.imp fun {eps} Fm _ _ a => ?_⟩
  obtain ⟨x₀, hx₀⟩ := hQ eps CF hCF
  obtain ⟨x₁, a⟩ := a
  refine ⟨max x₀ x₁, fun x hx hle i p hp G W n b hb => ?_⟩
  exact hx₀ _ (Fm.L x i) (Fm.L_eps x i) ((le_of_max_le_left hle).trans (Fm.L_x x i hx).ge) _ _ _ _ _ _ _
    (a x hx (le_of_max_le_right hle) i p hp hb.eser) b.ch hb.is b.atScale
end GlobalTheory.BigTop.Fun
