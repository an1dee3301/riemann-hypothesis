  haveI : BorelSpace (HermR (Ainf F) σ 1) := ⟨rfl⟩
  obtain ⟨t1, t2, t3, t4, -, -, -, t8, t9, -⟩ := GlobalTheory.T.tensor_locally_compact_ring F E σ hcm (Ainf F)
  haveI := t1
  haveI := t2
