instance isAlgClosure_rat : IsAlgClosure ℚ (AlgebraicClosure ℚ) := by
  let i : Algebra ℚ (AlgebraicClosure ℚ) := AlgebraicClosure.instAlgebra ℚ (R := ℚ)
